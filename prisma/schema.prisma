// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformName {
  X
  TELEGRAM
}

enum SourcePrice {
  MONTHLY
  LIFETIME
  FREE
}

enum SourceStatus {
  PROCESSING
  VALIDE
  INVALIDE
}

enum SourceMessageType {
  photo
  text
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  login        String
  password     String
  isAdmin      Boolean   @default(false)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  lastLogin    DateTime?
  refreshToken String?

  emailVerified Boolean @default(false)

  twoFactorAuthEnabled Boolean @default(false)
  twoFactorAuthSecret  String?
  twoFactorAuthMethod  String? @default("AUTH_APP")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt()
  Setup         Setup[]
  UserSource    UserSource[]
  notifications Notification[]
}

model Source {
  id            Int          @id @default(autoincrement())
  source_status SourceStatus @default(PROCESSING)

  platform                  PlatformName @default(X)
  source_url                String       @default("")
  platform_user_picture     String
  user_name_source          String
  user_username_source      String
  user_id_source            String
  user_verified             Boolean      @default(false)
  user_creation_date        Int
  followers_count           Int          @default(0)
  source_subscription_plan  SourcePrice  @default(FREE)
  source_subscription_price Int?

  deleted_count Int @default(0)

  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt()
  SourcePost  SourcePost[]
  Signal      Signal[]
  SourceStats SourceStats[]
  UserSource  UserSource[]

  bad_signals_count      Int            @default(0)
  signals_count_last_30d Int            @default(0)
  notifications          Notification[]

  @@unique([platform, user_id_source])
}

model UserSource {
  id        Int      @id @default(autoincrement())
  user_id   Int
  source_id Int
  // source_username String
  added_at  DateTime @default(now())

  // Per-user settings (moved from Source)
  source_activated                Boolean @default(true)
  source_reverse_signal_activated Boolean @default(false)
  is_mandatory                    Boolean @default(false)
  display_name                    String  @default("")
  topCorrelations                 Json    @default("[]")

  User   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Source Source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  SourceSetup SourceSetup?

  @@unique([user_id, source_id])
  @@index([user_id])
  @@index([source_id])
}

model SourceSetup {
  id           Int        @id @default(autoincrement())
  userSourceId Int        @unique
  UserSource   UserSource @relation(fields: [userSourceId], references: [id], onDelete: Cascade)

  source_setup_filter_btc          Boolean @default(true)
  source_setup_filter_eth          Boolean @default(true)
  source_setup_filter_sol          Boolean @default(true)
  source_setup_filter_alts         Boolean @default(true)
  source_setup_filter_bullish      Boolean @default(true)
  source_setup_filter_bearish      Boolean @default(true)
  source_setup_filter_binance_only Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SourceStats {
  id              Int      @id @default(autoincrement())
  sourceId        Int
  period          String
  stats           Json
  recommendations Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  Source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, period])
}

model SourcePost {
  id           Int               @id @default(autoincrement())
  sourceId     Int
  platform     PlatformName      @default(X)
  timestamp    Int?
  date         DateTime?
  originalId   String
  mediaType    SourceMessageType
  senderId     String?           @db.MediumText
  originalText String            @db.MediumText
  text         String            @db.MediumText
  post_url     String            @default("")
  analysis     Json

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt()
  Source         Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  Signal         Signal[]
  PostValidation PostValidation[]
}

model PostValidation {
  id           Int      @id @default(autoincrement())
  sourcePostId Int
  checkedAt    DateTime @default(now())
  exists       Boolean // true if post still exists, false if deleted
  errorMessage String?  @db.Text // Error message if check failed
  metadata     Json? // Additional info (API response, etc.)

  SourcePost SourcePost @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@index([sourcePostId])
  @@index([checkedAt])
}

// SIGNALS
enum SignalTrendLvl {
  VTC
  VC
  V100
  RTC
  RC
  R100
}

enum SignalTrend {
  LONG
  SHORT
}

enum SignalStatus {
  NEW
  OPEN
  CLOSED
  PASSED
}

model Signal {
  id             Int    @id @default(autoincrement())
  sourceId       Int
  source_post_id Int
  sourceIds      String @default("[]")

  signal_trend_level SignalTrendLvl
  signal_trend       SignalTrend
  status             SignalStatus
  currency_logo      String
  currency_label     String
  pnlA               Float          @default(0)
  pnlP               Float          @default(0)
  coin_id            Int? // CoinMarketCap coin ID
  entry_timestamp    DateTime
  entry_price        Float          @default(0)
  exit_price         Float?
  sources_nbr        Int            @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  SourcePost                 SourcePost @relation(fields: [source_post_id], references: [id], onDelete: Cascade)
  Source                     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  meta                       Json?
  isComplete                 Boolean    @default(false)
  pivot_calc_days            Int        @default(0)
  ai_price_trace_analysis    String?    @db.Text
  ai_price_trace_analysis_at DateTime?
  ai_token_analysis          Json?
  ai_token_analysis_at       DateTime?

  @@unique([sourceId, source_post_id])
}

model Setup {
  id         Int    @id @default(autoincrement())
  user_db_id Int
  name       String

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
}

enum NotificationType {
  SOURCE_ADDED
  SOURCE_SUSPENDED
  NEW_SIGNALS
  POST_DELETED
  GENERIC
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  url       String?          @default("")
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  User     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   Source? @relation(fields: [sourceId], references: [id])
  sourceId Int?
}
