// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformName {
  X
  TELEGRAM
}

enum SourcePrice {
  MONTHLY
  LIFETIME
  FREE
}

enum SourceStatus {
  PROCESSING
  VALIDE
  INVALIDE
}

enum SourceMessageType {
  photo
  text
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  login        String
  password     String
  isAdmin      Boolean   @default(false)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  lastLogin    DateTime?
  refreshToken String?

  emailVerified Boolean @default(false)

  twoFactorAuthEnabled Boolean @default(false)
  twoFactorAuthSecret  String?
  twoFactorAuthMethod  String? @default("AUTH_APP")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt()
  Source    Source[]
  Signal    Signal[]
  Setup     Setup[]
}

model Source {
  id         Int @id @default(autoincrement())
  user_db_id Int

  source_status SourceStatus @default(PROCESSING)

  platform_logo                   String
  display_name                    String      @default("")
  platform_user_picture           String
  user_name_source                String
  user_username_source            String
  user_id_source                  String
  user_verified                   Boolean     @default(false)
  user_creation_date              Int
  followers_count                 Int         @default(0)
  source_price                    SourcePrice @default(FREE)
  source_price_value              String?
  price                           Int?
  source_activated                Boolean     @default(false)
  source_reverse_signal_activated Boolean     @default(false)

  // source_reverse_signal_profit Int?

  // source_total_quantity_signals Int?
  // source_global_probility       Int?

  // source_bullish_total_quantity Int?
  // source_bullish_percentage     Decimal? @db.Decimal(20, 8)
  // source_bullish_probility      Decimal? @db.Decimal(20, 8)

  // source_bearish_total_quantity Int?
  // source_bearish_percentage     Decimal? @db.Decimal(20, 8)
  // source_bearish_probility      Decimal? @db.Decimal(20, 8)

  // btc_total_quantity Int?
  // btc_probility      Decimal? @db.Decimal(20, 8)

  // eth_total_quantity Int?
  // eth_probility      Decimal? @db.Decimal(20, 8)

  // sol_total_quantity Int?
  // sol_probility      Decimal? @db.Decimal(20, 8)

  // alts_total_quantity Int?
  // alts_probility      Decimal? @db.Decimal(20, 8)

  // Post validation & reliability metrics
  source_validation_total_checks  Int       @default(0)
  source_validation_deleted_count Int       @default(0)
  source_validation_deletion_rate Decimal?  @db.Decimal(5, 2) // Percentage 0-100
  source_validation_last_check    DateTime?
  source_truth_score              Decimal?  @db.Decimal(5, 2) // 0-100 score

  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt()
  SourcePost  SourcePost[]
  User        User          @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
  Signal      Signal[]
  SourceStats SourceStats[]
}

model SourceStats {
  id              Int      @id @default(autoincrement())
  sourceId        Int
  period          String // e.g., "ALL", "1M", "3M", "6M", "1Y"
  stats           Json // Stores the calculated stats (optimal_exit, top_signals, etc.)
  recommendations Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  Source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, period])
}

model SourcePost {
  id           Int               @id @default(autoincrement())
  sourceId     Int
  sourceType   PlatformName
  timestamp    Int?
  date         DateTime?
  originalId   String
  mediaType    SourceMessageType
  senderId     String?           @db.MediumText
  originalText String            @db.MediumText
  text         String            @db.MediumText
  analysis     Json

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt()
  Source         Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  Signal         Signal[]
  PostValidation PostValidation[]
}

model PostValidation {
  id           Int      @id @default(autoincrement())
  sourcePostId Int
  checkedAt    DateTime @default(now())
  exists       Boolean // true if post still exists, false if deleted
  errorMessage String?  @db.Text // Error message if check failed
  metadata     Json? // Additional info (API response, etc.)

  SourcePost SourcePost @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@index([sourcePostId])
  @@index([checkedAt])
}

// SIGNALS
enum SignalTrendLvl {
  VTC
  VC
  V100
  RTC
  RC
  R100
}

enum SignalTrend {
  LONG
  SHORT
}

enum SignalStatus {
  NEW
  OPEN
  CLOSED
  PASSED
}

model Signal {
  id             Int    @id @default(autoincrement())
  user_db_id     Int
  sourceId       Int
  source_post_id Int
  sourceIds      String @default("[]")

  signal_trend_level SignalTrendLvl
  signal_trend       SignalTrend
  status             SignalStatus
  currency_logo      String
  currency_label     String
  pnlA               Float          @default(0)
  pnlP               Float          @default(0)
  coin_id            Int? // CoinMarketCap coin ID
  entry_timestamp    DateTime
  entry_price        Float          @default(0)
  exit_price         Float?
  sources_nbr        Int            @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  User                       User       @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
  SourcePost                 SourcePost @relation(fields: [source_post_id], references: [id], onDelete: Cascade)
  Source                     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  meta                       Json?
  isComplete                 Boolean    @default(false)
  pivot_calc_days            Int        @default(0)
  ai_price_trace_analysis    String?    @db.Text
  ai_price_trace_analysis_at DateTime?
}

model Setup {
  id         Int    @id @default(autoincrement())
  user_db_id Int
  name       String

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
}
