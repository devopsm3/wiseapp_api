// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformName {
  X
  TELEGRAM
}

enum SourcePrice {
  MONTHLY
  LIFETIME
  FREE
}

enum SourceStatus {
  PROCESSING
  VALIDE
  INVALIDE
}

enum SourceMessageType {
  photo
  text
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  login        String
  password     String
  isAdmin      Boolean   @default(false)
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  lastLogin    DateTime?
  refreshToken String?

  emailVerified Boolean @default(false)

  twoFactorAuthEnabled Boolean @default(false)
  twoFactorAuthSecret  String?
  twoFactorAuthMethod  String? @default("AUTH_APP")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt()
  Source    Source[]
  Signal    Signal[]
  Setup     Setup[]
}

model Source {
  id         Int @id @default(autoincrement())
  user_db_id Int

  source_status SourceStatus @default(PROCESSING)

  platform_logo                   String
  platform_user_picture           String
  user_name_source                String
  user_username_source            String
  user_id_source                  String
  user_verified                   Boolean     @default(false)
  user_creation_date              Int
  followers_count                 Int         @default(0)
  source_price                    SourcePrice @default(FREE)
  source_price_value              String?
  price                           Int?
  source_activated                Boolean     @default(false)
  source_reverse_signal_activated Boolean     @default(false)

  source_total_quantity_signals Int?
  source_global_probility       Int?

  source_reverse_signal_profit Int?

  source_bullish_total_quantity Int?
  source_bullish_percentage     Decimal? @db.Decimal(20, 8)
  source_bullish_probility      Decimal? @db.Decimal(20, 8)

  source_bearish_total_quantity Int?
  source_bearish_percentage     Decimal? @db.Decimal(20, 8)
  source_bearish_probility      Decimal? @db.Decimal(20, 8)

  btc_total_quantity Int?
  btc_probility      Decimal? @db.Decimal(20, 8)

  eth_total_quantity Int?
  eth_probility      Decimal? @db.Decimal(20, 8)

  sol_total_quantity Int?
  sol_probility      Decimal? @db.Decimal(20, 8)

  alts_total_quantity Int?
  alts_probility      Decimal?     @db.Decimal(20, 8)
  metadata            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt()
  SourcePost          SourcePost[]
  User                User         @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
  Signal              Signal[]
}

model SourcePost {
  id           Int               @id @default(autoincrement())
  sourceId     Int
  sourceType   PlatformName
  timestamp    Int?
  date         DateTime?
  originalId   Int
  mediaType    SourceMessageType
  senderId     String?
  originalText String            @db.MediumText
  text         String            @db.MediumText
  analysis     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt()
  Source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  Signal    Signal[]
}

// SIGNALS
enum SignalTrendLvl {
  VTC
  VC
  V100
  RTC
  RC
  R100
}

enum SignalTrend {
  LONG
  SHORT
}

enum SignalStatus {
  NEW
  OPEN
  CLOSED
  PASSED
}

enum ManualOverride {
  OPEN
  PASS
  CLOSE
}

model Signal {
  id             Int @id @default(autoincrement())
  user_db_id     Int
  sourceId       Int
  source_post_id Int

  signal_trend_level SignalTrendLvl
  signal_trend       SignalTrend
  status             SignalStatus
  manual_override    ManualOverride?

  currency_logo   String?
  currency_label  String
  pnlA            Decimal?  @db.Decimal(20, 8)
  pnlP            Decimal?  @db.Decimal(20, 8)
  time_frame      String
  entry_timestamp DateTime?
  entry_price     Decimal?  @db.Decimal(20, 8)
  exit_price      Decimal?  @db.Decimal(20, 8)
  sources_nbr     Int       @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  User       User       @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
  SourcePost SourcePost @relation(fields: [source_post_id], references: [id], onDelete: Cascade)
  Source     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model Setup {
  id         Int    @id @default(autoincrement())
  user_db_id Int
  name       String

  sources      Json?
  meta_signals Json?
  trading      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [user_db_id], references: [id], onDelete: Cascade)
}
